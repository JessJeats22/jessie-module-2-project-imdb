<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/form.css">
    <title class="page.title"> Edit <%= movie.title %></title>
  </head>
  <body>
    <%- include('../partials/navbar.ejs') %>

    <div class="page-container edit-page">
      <h1 class="page-title">Edit a Movie!</h1>

      <div class="form-card">

        <form class="edit-form" action="/movies/<%= movie._id %>?_method=PUT" method="POST">

          <div class="form-group">
            <label for="movieTitle">Movie Title:</label>
            <input type="text" name="title" id="title" value="<%= movie.title %>" />
          </div>

          <div class="form-group">
            <label for="genre">Genre:</label>
            <input type="text" name="genre" id="genre" value="<%= movie.genre %>" />
          </div>

          <div class="form-group">
            <label for="description">Description:</label>
            <input type="text" name="description" id="description" value="<%= movie.description %>" />
          </div>

          <div class="form-group">
            <label for="year">Year:</label>
            <input type="number" name="year" id="year" value="<%= movie.year %>" />
          </div>

          <button class="btn btn-submit" type="submit">Update Movie</button>
        </form>

        <form class="duplicate-edit-form" action="/movies/<%= movie._id %>?_method=PUT" method="POST">
          <button class="btn btn-secondary" type="submit">Edit Listing</button>
        </form>

      </div>
    </div>

  </body>
</html>
