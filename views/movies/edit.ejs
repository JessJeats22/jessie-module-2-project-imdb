<!-- views/listings/edit.ejs -->

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css">
        <title>Edit <%= movie.title %></title>
  </head>
  <body>
     <%- include('../partials/navbar.ejs') %>
    <h1>Edit a Movie!</h1>


    <!-- views/listings/edit.ejs -->

<form action="/movies/<%= movie._id %>?_method=PUT" method="POST">

  <label for="movieTitle">Movie Title:</label>
  <input type="text" name="title" id="title" value="<%= movie.title %>" />

  <label for="genre">Genre:</label>
  <input type="text" name="genre" id="genre" value="<%= movie.genre %>" />

  <label for="description">Description:</label>
  <input type="text" name="description" id="description" value="<%= movie.description %>" />

  <label for="year">Year:</label>
  <input type="number" name="year" id="year" value="<%= movie.year %>" />

  <button type="submit">Update Movie</button>
</form>


    <form action="/movies/<%= movie._id %>?_method=PUT" method="POST">
        <button type="submit">Edit Listing</button>
    </form>


  </body>
</html>
