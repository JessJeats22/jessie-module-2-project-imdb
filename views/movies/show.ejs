<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Movies</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <%- include('../partials/navbar.ejs') %>

  <h1>Movies List</h1>

 <li>      
          <p><span class="label">Title:</span> <%= movie.title %></p>
          <p><span class="label">Description:</span> <%= movie.description %></p>
          <p><span class="label">Year:</span> <%= movie.year %></p>
          <p><span class="label">Genre:</span> <%= movie.genre %></p>
          <% if (movie.addedBy?.username) { %>
            <p><span class="label">Added by:</span> <%= movie.addedBy.username %></p>
          <% } %>
        </li>


        <form action="/movies/<%= movie._id %>?_method=DELETE" method="POST">
            <button type="submit">Delete <%= movie.title %></button>
        </form>
            <a href="/movies">Back to All Movies</a>


</body>
</html>