<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Movies</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <%- include('../partials/navbar.ejs') %>

  <h1>Movies List</h1>

 <li>      
          <p><span class="label">Title:</span> <%= movie.title %></p>
          <p><span class="label">Description:</span> <%= movie.description %></p>
          <p><span class="label">Year:</span> <%= movie.year %></p>
          <p><span class="label">Genre:</span> <%= movie.genre %></p>
         
          <% if (movie.addedBy._id.equals(user._id)) { %>
            <p><span class="label">Added by:</span> You added this movie!</p>

        <form action="/movies/<%=movie._id%>?_method=DELETE" method="POST">
        <button type="submit">Delete <%= movie.title %></button>

          <a href="/movies/<%= movie._id %>/edit">Edit this movie</a>
       
          </form>

          <% } else { %>
            <p><span class="label">Added by:</span> You don't own this, <%= movie.addedBy.username %> does!</p>
           <% } %>
</li>

        
            <a href="/movies">Back to Movies</a>


</body>
</html>